{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transnote.dev/schema/block.schema.json",
  "title": "Block",
  "description": "文档块（契约 §8.2/§9.2 唯一事实源）。TS 类型由本文件同步（json-schema-to-typescript 后置）。",
  "type": "object",
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "type": {
      "type": "string",
      "enum": ["paragraph", "heading", "todo", "list", "quote", "code", "image", "table"]
    },
    "content": {
      "type": "object",
      "properties": {
        "text": { "type": ["string", "null"] },
        "checked": { "type": ["boolean", "null"] },
        "level": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
        "url": { "type": ["string", "null"] },
        "rows": {
          "type": ["array", "null"],
          "items": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "children": { "type": ["array", "null"], "items": { "$ref": "#" } },
    "parentId": { "type": ["string", "null"] },
    "position": { "type": ["integer", "null"] },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "required": ["id", "type", "content"]
}
